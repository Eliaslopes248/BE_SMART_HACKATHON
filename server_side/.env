#======================================================================
# THIS IS THE DEFAULT .ENV FILE (USE IN DEV MODE ONLY)
#======================================================================

NODE_ENV=dev

# set server access varaibles
PORT=3000

# endpoint variables
BASE_URL=http://localhost:3000

IP_ADDRESS=NONE
#======================================================================
# DATABASE CONFIGURATION (AWS RDS)
#======================================================================

# Database connection settings
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# AWS RDS IAM Authentication
# Set to 'true' or '1' to use IAM authentication instead of password
DB_USE_IAM_AUTH=false

# AWS Region for RDS
AWS_REGION=us-east-1
DB_REGION=

# SSL Configuration
# Set to 'true' or '1' to enable SSL connection
DB_SSL=true

# Connection Pool Settings
DB_CONNECTION_LIMIT=10


# custom session token variables
JWT_SECRET="90eccefdafb694330b3a5d4780386abc323879d75e423eb78827ff7ef4fc3c64dbc06ce59d8b56f36615576f5f4f19a3a76d57ed089404a3a8a611647ff22be5"
REDIS_HOST=localhost
REDIS_PORT=6379
