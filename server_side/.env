#======================================================================
# THIS IS THE DEFAULT .ENV FILE (USE IN DEV MODE ONLY)
#======================================================================

NODE_ENV=dev

# set server access varaibles
PORT=3000

# endpoint variables
BASE_URL=http://localhost:3000

IP_ADDRESS=NONE
#======================================================================
# DATABASE CONFIGURATION (AWS RDS)
#======================================================================

# Database connection settings
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# AWS RDS IAM Authentication
# Set to 'true' or '1' to use IAM authentication instead of password
DB_USE_IAM_AUTH=false

# AWS Region for RDS
AWS_REGION=us-east-1
DB_REGION=

# SSL Configuration
# Set to 'true' or '1' to enable SSL connection
DB_SSL=true

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
